# 莊錦鎮脊椎治療中心 — 正式環境設定
# 修正舊站的三個問題：soft 404、www 未正規化、無快取標頭

stewartchenchiro.com, www.stewartchenchiro.com {
    root * /var/www/stewartchenchiro/dist

    # www → 非 www（避免重複內容）
    @www host www.stewartchenchiro.com
    redir @www https://stewartchenchiro.com{uri} permanent

    # /index.html → /
    @indexhtml path /index.html
    redir @indexhtml / permanent

    encode gzip zstd

    # 靜態資源長快取
    @static path *.css *.js *.webp *.jpg *.jpeg *.png *.svg *.woff2
    header @static Cache-Control "public, max-age=31536000, immutable"

    # HTML 短快取
    @html path *.html /
    header @html Cache-Control "public, max-age=3600"

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # 真正的 404（舊站所有網址都回 200 首頁，這是最嚴重的技術缺陷）
    handle_errors {
        @404 expression {err.status_code} == 404
        rewrite @404 /404.html
        file_server
    }

    file_server
}

# 舊網域導向（客戶名下，目前 DNS 有解析但無回應）
stewartchen.net, www.stewartchen.net {
    redir https://stewartchenchiro.com{uri} permanent
}
